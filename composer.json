{
    "name": "scrapyard-io/waveforms",
    "description": "The ScrapyardIO Sensor Framework.",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "version": "0.6.0",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "support": {
        "issues": "https://github.com/scrapyard-io/gpio-framework/issues",
        "source": "https://github.com/scrapyard-io/gpio-framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/sensors": "^0.6.0",
        "fabricate/circuits": "^0.6.0"
    },
    "replace": {
        "waveforms/acceleration": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "files": [],
        "psr-4": {
            "ScrapyardIO\\Waveforms\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.6-dev"
        },
        "scrapyard-io": {
            "providers": [
                "ScrapyardIO\\Waveforms\\Core\\Providers\\WaveformsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
